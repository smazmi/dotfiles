[user]
	email = sadiquemobaraka5@gmail.com
	name = Sadique Azmi
	signingkey = sadiquemobaraka5@gmail.com

[commit]
	gpgsign = true

[core]
	editor = nvim

[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta

[include]
  path = ~/.config/git/delta.gitconfig

[log]
	abbrevCommit = true

[diff]
	algorithm = histogram

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[pull]
	rebase = true

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true  
  dark = true
	side-by-side = true
	features = catppuccin-mocha
	line-numbers = true

[merge]
	conflictStyle = zdiff3
