[user]
	email = sadiquemobaraka5@gmail.com
	name = Sadique Azmi
	signingkey = sadiquemobaraka5@gmail.com

[commit]
	gpgsign = true

[core]
	editor = nvim
	pager = delta

[diff]
	tool = nvimdiff

[log]
	abbrevCommit = true

[diff]
	algorithm = histogram

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[pull]
	rebase = true

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true  
  dark = true
	side-by-side = true

[merge]
	conflictStyle = zdiff3
